---
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.shortName}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/security', label: 'Security' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={site.links.x.handle} />
    <meta name="theme-color" content="#f3f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let t;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <script is:inline data-goatcounter="https://tehilafavourite.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="mark" href="/" aria-label={`${site.name}, home`}>
          <span class="mono-box" aria-hidden="true">FA</span>
          <span class="who">
            <span class="name">{site.shortName}</span>
            <span class="role meta">{site.title}</span>
          </span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path === n.href || path.startsWith(n.href + '/') ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch colour theme">
          <span class="when-light">Dark</span><span class="when-dark">Light</span>
        </button>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap grid">
        <p class="c-6 meta">© {year} {site.name}</p>
        <p class="c-6 meta foot-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.links.github.url}>GitHub</a>
          <a href={site.links.linkedin.url}>LinkedIn</a>
        </p>
      </div>
    </footer>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .mono-box {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .who {
    display: grid;
    line-height: 1.25;
  }

  .name {
    font-weight: 700;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-family: var(--mono);
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 4px;
    border-bottom: 1.5px solid transparent;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent-line);
  }

  .theme-toggle {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--rule);
    padding: 4px 8px;
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  :global([data-theme='dark']) .when-light,
  :global([data-theme='light']) .when-dark {
    display: none;
  }

  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--rule);
    padding-block: 24px 40px;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 18px;
    max-width: none;
  }

  @media (max-width: 860px) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-block: 14px;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    nav ul {
      justify-content: flex-start;
    }
    .role {
      display: none;
    }
    .site-footer .grid > * {
      grid-column: span 12;
    }
    .foot-links {
      justify-content: flex-start;
      margin-top: 8px;
    }
  }
</style>
