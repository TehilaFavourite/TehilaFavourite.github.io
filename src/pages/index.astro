---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import SecurityRow from '../components/SecurityRow.astro';
import RepoRow from '../components/RepoRow.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { getCompanies, getSecurity, formatDate } from '../lib/content';
import { getRepos } from '../lib/github';
import { getArticles } from '../lib/writing';
import site from '../data/site.json';
import now from '../data/now.json';

const security = (await getSecurity()).sort((a, b) => Number(b.data.featured) - Number(a.data.featured)).slice(0, 3);
const companies = await getCompanies();
const repos = await getRepos();
const articles = (await getArticles()).slice(0, 4);
const nowItems = [
  ['Auditing', now.auditing],
  ['Building', now.building],
  ['Reading', now.reading],
].filter(([, v]) => v);
const links = ['github', 'linkedin', 'x', 'medium'].map((k) => site.links[k as keyof typeof site.links]).filter((l) => l.url);
const stack: [string, string[]][] = [
  ['Languages', ['Solidity', 'Rust', 'PostgreSQL', 'JavaScript', 'TypeScript', 'Yul / Assembly', 'DAML', 'Python']],
  [
    'Frameworks',
    [
      'OpenZeppelin',
      'Hardhat',
      'Foundry',
      'Account Abstraction (ERC-4337)',
      'Docker',
      'Redis',
      'Truffle',
      'Chainlink',
      'Node.js',
      'React',
      'Apollo GraphQL',
      'MongoDB',
      'web3.js',
    ],
  ],
];
---

<Base>
  <section class="intro grid" aria-labelledby="intro-title">
    <div class="lede">
      <p class="label">Smart contract engineer · Rust · Security · Backend</p>
      <h1 id="intro-title">{site.name}</h1>
      <p class="big">
        I am a blockchain engineer with about five years of experience designing, building and shipping decentralised systems end to end. I work with Solidity, Yul and assembly, Rust, Python and TypeScript, and I have built production-grade infrastructure across EVM-compatible chains. My work spans Blockhain-based ride-hailing and mobility platforms, decentralised carbon-credit and climate markets, staking systems, covering smart contract architecture, DeFi mechanics, on-chain and off-chain integration, deployment and maintenance. I participate in public auditing platforms, and I write publicly about EVM, Security, Blockchain, and Rust.
      </p>
      {/* <p>
        I want to be the person who can prove that critical systems are secure, not just say they are.
      </p> */}
    </div>

    <aside class="spec" aria-label="Summary">
      <dl>
        <div><dt class="label">Focus</dt><dd>EVM, smart contracts, audits, Rust, formal verification</dd></div>
        <div><dt class="label">Experience</dt><dd>~5 years, production EVM systems</dd></div>
        <div><dt class="label">Based</dt><dd>{site.location}</dd></div>
        <div><dt class="label">Contact</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div>
          <dt class="label">Links</dt>
          <dd class="links">{links.map((l) => <a href={l.url}>{l.label}</a>)}</dd>
        </div>
      </dl>
      {nowItems.length > 0 && (
        <div class="now">
          <p class="label">Now · <time datetime={now.updated}>{formatDate(now.updated, 'day')}</time></p>
          <dl>
            {nowItems.map(([k, v]) => (
              <div><dt class="meta">{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </div>
      )}
    </aside>

    <dl class="stack">
      {stack.map(([k, items]) => (
        <div>
          <dt class="label">{k}</dt>
          <dd><ul class="tags">{items.map((t) => <li>{t}</li>)}</ul></dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sec" aria-labelledby="h-work">
    <SectionHead id="h-work" num="01" title="Work" href="/work" linkText="All work" />
    <ul class="rows">
      {companies.map((c) => (
        <li>
          <div class="row">
            <p class="c-4 title">{c.url ? <a href={c.url} rel="noopener">{c.name}</a> : c.name}</p>
            <p class="c-8 projects">
              {c.projects.map((p, i) => (
                <>
                  {i > 0 && <span class="sep" aria-hidden="true"> / </span>}
                  <a href={`/work/${c.slug}/${p.slug}`}>{p.name}</a>
                </>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" aria-labelledby="h-projects">
    <SectionHead id="h-projects" num="02" title="Projects" href="/projects" linkText="All projects" />
    <ul class="rows">{repos.map((r) => <RepoRow repo={r} />)}</ul>
  </section>

  <section class="sec" aria-labelledby="h-writing">
    <SectionHead id="h-writing" num="03" title="Latest writing" href="/writing" linkText="All writing" />
    <ul class="rows">{articles.map((a) => <ArticleRow article={a} />)}</ul>
  </section>

  <section class="sec" aria-labelledby="h-security">
    <SectionHead id="h-security" num="04" title="Security work" href="/security" linkText="All security work" />
    <ul class="rows">{security.map((e) => <SecurityRow entry={e} showType />)}</ul>
  </section>
</Base>

<style>
  .intro {
    padding-block: 64px 24px;
    row-gap: 40px;
  }
  .lede {
    grid-column: span 8;
    display: grid;
    gap: 16px;
    align-content: start;
  }
  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  .big {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .stack {
    grid-column: 1 / -1;
    margin: 40px 0 0;
    border-top: 1.5px solid var(--rule-strong);
  }
  .stack > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .stack dd {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1;
    padding: 6px 9px;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink-2);
  }
  .spec {
    grid-column: span 4;
    border-top: 1.5px solid var(--rule-strong);
    align-self: start;
  }
  .spec dl {
    margin: 0;
  }
  .spec dl > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding-block: 9px;
    border-bottom: 1px solid var(--rule);
  }
  .spec dd {
    margin: 0;
    font-size: 0.9375rem;
  }
  .now {
    margin-top: 28px;
  }
  .now .label {
    color: var(--accent);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .projects {
    max-width: none;
  }
  .sep {
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .lede,
    .spec {
      grid-column: span 12;
    }
  }
</style>
